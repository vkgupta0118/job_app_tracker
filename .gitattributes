# Normalize line endings: store text as LF in the repo, let Git handle the
# working-copy conversion per-OS. Stops the "LF will be replaced by CRLF" noise.
* text=auto eol=lf

# Treat lockfiles and these as text explicitly.
*.json   text eol=lf
*.md     text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.css    text eol=lf
*.sql    text eol=lf
